# Copy to .env and adjust. All values are optional; defaults are shown.

# Folder containing the source code (and Dockerfile) to build from.
# Relative paths are resolved from this compose file's folder.
# APP_PATH=/mnt/user/appdata/home-portal-src
APP_PATH=.

# Port on the host the portal is reachable on.
HOST_PORT=8080

# Where cards.json is stored on the host. On Unraid use appdata:
# DATA_PATH=/mnt/user/appdata/home-portal
DATA_PATH=./data

# User/group the container runs as (Unraid default: nobody:users).
PUID=99
PGID=100

TZ=Etc/UTC
